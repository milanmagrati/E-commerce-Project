SECRET_KEY=your-django-secret-key-here
DEBUG=True

# MySQL Database Configuration
DB_NAME=ecommerceadmin
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_HOST=localhost
DB_PORT=3306

# NCM API Configuration
NCM_API_KEY=your_ncm_api_key
NCM_API_BASE_URL=https://staging.nepalcanmove.com/api/v1
NCM_API_BASE_URL_V2=https://staging.nepalcanmove.com/api/v2
NCM_WEBHOOK_SECRET=your_ncm_webhook_secret_here

# WooCommerce
WOOCOMMERCE_WEBHOOK_SECRET=your_woocommerce_webhook_secret_here
NCM_WEBHOOK_URL=https://your-domain.com/ncm/webhook/

# Pick and Drop API Configuration
PND_API_KEY=your_pnd_api_key
PND_API_SECRET=your_pnd_api_secret
PND_API_BASE_URL=https://pickndropnepal.com
