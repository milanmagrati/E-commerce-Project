SECRET_KEY=your-django-secret-key-here
DEBUG=False

# MySQL Database Configuration
DB_NAME=ecommerceadmin
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_HOST=localhost
DB_PORT=3306

# Redis — required for real-time WebSockets (Follow-ups page)
REDIS_URL=redis://127.0.0.1:6379

# NCM API Configuration
NCM_API_KEY=your_ncm_api_key
NCM_API_BASE_URL=https://portal.nepalcanmove.com/api/v1
NCM_API_BASE_URL_V2=https://portal.nepalcanmove.com/api/v2
NCM_WEBHOOK_SECRET=your_ncm_webhook_secret_here
NCM_WEBHOOK_URL=https://your-domain.com/ncm/webhook/

# WooCommerce
WOOCOMMERCE_WEBHOOK_SECRET=your_woocommerce_webhook_secret_here

# Pick and Drop API Configuration
PND_API_KEY=your_pnd_api_key
PND_API_SECRET=your_pnd_api_secret
PND_API_BASE_URL=https://pickndropnepal.com
SITE_URL=https://office.orajil.com.np
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Meta / Instagram Configuration
META_PAGE_ACCESS_TOKEN=your_token_here
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
INSTAGRAM_APP_ID=your_instagram_app_id
INSTAGRAM_APP_SECRET=your_instagram_app_secret

# TikTok Configuration
TIKTOK_APP_ID=your_tiktok_app_id
TIKTOK_APP_SECRET=your_tiktok_app_secret

# AI Model API Keys — used by trendycrm/ai_router.py for the Chatbot (AI) feature
OPENAI_API_KEY=
GEMINI_API_KEY=
