            gap: 0.35rem;
        }

        .lsn-stock {
            background: #fbbf24;
            color: #78350f;
            font-size: 0.7rem;
            font-weight: 700;
            padding: 0.05rem 0.4rem;
            border-radius: 4px;
        }

        .lsn-more {
            color: #b45309;
            font-size: 0.8rem;
            font-weight: 600;
            padding: 0.2rem 0.5rem;
        }

        .lsn-actions {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            flex-shrink: 0;
        }

        .lsn-view-btn {
            background: #f59e0b;
            color: #fff;
            padding: 0.4rem 1rem;
            border-radius: 8px;
            font-size: 0.8rem;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.2s;
            white-space: nowrap;
        }

        .lsn-view-btn:hover {
