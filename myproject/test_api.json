            margin-right: 0.5rem;
        }

        .lsn-count-badge {
            background: #f59e0b;
            color: #fff;
            font-size: 0.75rem;
            font-weight: 700;
            padding: 0.15rem 0.55rem;
            border-radius: 10px;
            vertical-align: middle;
        }

        .lsn-items {
            display: flex;
            flex-wrap: wrap;
            gap: 0.4rem;
            margin-top: 0.4rem;
        }

        .lsn-item {
            background: rgba(245, 158, 11, 0.1);
            border: 1px solid rgba(245, 158, 11, 0.25);
