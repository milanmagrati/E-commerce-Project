<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign In - Blanxer Admin</title>
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- ✅ Alertify.js for Real-time Notifications -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/alertifyjs@1.13.1/build/css/alertify.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/alertifyjs@1.13.1/build/css/themes/default.min.css">
    
    <!-- Maintenance Overlay CSS -->
    <style>
        .maintenance-overlay {
            position: fixed;
            inset: 0;
            z-index: 99999;
            background: linear-gradient(135deg, #1e1b4b 0%, #312e81 40%, #4c1d95 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            flex-direction: column;
            text-align: center;
            padding: 2rem;
            overflow: hidden;
        }

        .maintenance-overlay::before {
            content: '';
            position: absolute;
            inset: 0;
            background: url("data:image/svg+xml,%3Csvg width='60' height='60' xmlns='http://www.w3.org/2000/svg'%3E%3Cdefs%3E%3Cpattern id='grid' width='60' height='60' patternUnits='userSpaceOnUse'%3E%3Cpath d='M 60 0 L 0 0 0 60' fill='none' stroke='rgba(255,255,255,0.04)' stroke-width='1'/%3E%3C/pattern%3E%3C/defs%3E%3Crect width='100%25' height='100%25' fill='url(%23grid)'/%3E%3C/svg%3E");
            pointer-events: none;
        }

        .maintenance-overlay * {
            position: relative;
            z-index: 1;
        }

        .maintenance-gear {
            width: 100px;
            height: 100px;
            border-radius: 50%;
            background: rgba(255, 255, 255, .08);
            border: 2px solid rgba(255, 255, 255, .15);
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 1.75rem;
            animation: mntGearPulse 3s ease-in-out infinite;
        }

        .maintenance-gear i {
            font-size: 2.5rem;
            color: #fbbf24;
            animation: mntGearSpin 8s linear infinite;
        }

        .maintenance-title {
            font-size: 2rem;
            font-weight: 800;
            color: #fff;
            margin-bottom: .5rem;
            letter-spacing: -.02em;
        }

        .maintenance-msg {
            font-size: 1.05rem;
            color: rgba(255, 255, 255, .65);
            max-width: 500px;
            line-height: 1.6;
            margin-bottom: 2rem;
        }

        .maintenance-dots {
            display: flex;
            gap: 8px;
            margin-bottom: 2rem;
        }

        .maintenance-dots span {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background: rgba(255, 255, 255, .3);
            animation: mntDotBounce 1.4s ease-in-out infinite;
        }

        .maintenance-dots span:nth-child(2) {
            animation-delay: .15s;
        }

        .maintenance-dots span:nth-child(3) {
            animation-delay: .3s;
        }

        .maintenance-footer {
            font-size: .82rem;
            color: rgba(255, 255, 255, .35);
            margin-bottom: 1.5rem;
        }

        /* Logout button on overlay */
        .maintenance-logout-btn {
            display: inline-flex;
            align-items: center;
            gap: .5rem;
            padding: .6rem 1.75rem;
            border-radius: 50px;
            background: rgba(255, 255, 255, .12);
            color: rgba(255, 255, 255, .85);
            border: 1.5px solid rgba(255, 255, 255, .25);
            font-size: .88rem;
            font-weight: 600;
            text-decoration: none;
            transition: all .2s ease;
            backdrop-filter: blur(4px);
        }

        .maintenance-logout-btn:hover {
            background: rgba(255, 255, 255, .22);
            color: #fff;
            border-color: rgba(255, 255, 255, .5);
            transform: translateY(-1px);
            text-decoration: none;
        }

        .maintenance-user-hint {
            font-size: .75rem;
            color: rgba(255, 255, 255, .3);
            margin-bottom: .75rem;
        }

        /* Admin banner (shown to admins instead of overlay) */
        .maintenance-admin-banner {
            background: linear-gradient(90deg, #fef3c7, #fde68a);
            border-bottom: 2px solid #f59e0b;
            padding: .55rem 1.25rem;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: .75rem;
            font-size: .85rem;
            font-weight: 600;
            color: #92400e;
        }

        .maintenance-admin-banner i {
            font-size: 1rem;
        }

        .maintenance-admin-banner .badge {
            background: #f59e0b;
            color: #fff;
            font-size: .7rem;
            padding: .2rem .5rem;
            border-radius: 4px;
        }

        @keyframes mntGearPulse {

            0%,
            100% {
                transform: scale(1);
                opacity: 1
            }

            50% {
                transform: scale(1.05);
                opacity: .85
            }
        }

        @keyframes mntGearSpin {
            from {
                transform: rotate(0)
            }

            to {
                transform: rotate(360deg)
            }
        }

        @keyframes mntDotBounce {

            0%,
            80%,
            100% {
                transform: scale(0);
                opacity: .3
            }

            40% {
                transform: scale(1);
                opacity: 1
            }
        }

        /* ==================== EXPIRY NOTIFICATIONS ==================== */
        .expiry-alert-bar {
            background: linear-gradient(135deg, #fef3c7 0%, #ffedd5 100%);
            border-left: 4px solid #f59e0b;
            border-bottom: 1px solid #fed7aa;
            padding: 0.6rem 1rem;
            position: relative;
            z-index: 900;
            display: flex;
            justify-content: center;
        }

        .expiry-content {
            display: flex;
            align-items: center;
            max-width: 1200px;
            width: 100%;
            gap: 1rem;
        }

        .expiry-icon {
            font-size: 1.5rem;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .expiry-details {
            flex-grow: 1;
            min-width: 0; /* for truncation */
        }

        .expiry-title {
            margin: 0 0 0.2rem 0;
            font-size: 0.85rem;
            letter-spacing: 0.5px;
            color: #b45309;
            display: flex;
            align-items: center;
        }

        .expiry-list {
            display: flex;
            flex-wrap: wrap;
            gap: 0.5rem;
            font-size: 0.8rem;
        }

        .expiry-item {
            background: rgba(255, 255, 255, 0.7);
            padding: 0.15rem 0.5rem;
            border-radius: 4px;
            border: 1px solid rgba(245, 158, 11, 0.3);
            color: #78350f;
            display: flex;
            align-items: center;
            gap: 0.3rem;
            white-space: nowrap;
        }

        .expiry-item.expired-text {
            border-color: rgba(239, 68, 68, 0.3);
            color: #991b1b;
        }

        .expiry-badge {
            font-size: 0.65rem;
            padding: 0.1rem 0.3rem;
            border-radius: 3px;
            font-weight: 700;
        }

        .expiry-more {
            font-weight: 600;
            color: #b45309;
            align-self: center;
            padding-left: 0.25rem;
        }

        .expiry-actions {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            flex-shrink: 0;
        }

        .expiry-view-btn {
            background: #f59e0b;
            color: #fff;
            border: none;
            padding: 0.3rem 0.75rem;
            border-radius: 4px;
            font-size: 0.75rem;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.2s;
        }

        .expiry-view-btn:hover {
            background: #d97706;
            color: #fff;
        }

        .expiry-close {
            background: none;
            border: none;
            color: #9ca3af;
            font-size: 1.1rem;
            padding: 0;
            cursor: pointer;
            transition: color 0.2s;
        }

        .expiry-close:hover {
            color: #4b5563;
        }

        .pulse-alert i {
            animation: pulse-danger 2s infinite;
        }

        @keyframes pulse-danger {
            0% { transform: scale(1); opacity: 1; }
            50% { transform: scale(1.15); opacity: 0.8; }
            100% { transform: scale(1); opacity: 1; }
        }

        /* Expiry Modal Premium Styling */
        .expiry-modal-content {
            border: none;
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 20px 40px rgba(0,0,0,0.15);
        }
        .expiry-modal-header {
            background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
            color: white;
            border-bottom: none;
            padding: 1.5rem;
        }
        .expiry-modal-title {
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 0.75rem;
            margin: 0;
            font-size: 1.25rem;
        }
        .expiry-modal-header .btn-close {
            filter: brightness(0) invert(1);
            opacity: 0.8;
            transition: opacity 0.2s;
        }
        .expiry-modal-header .btn-close:hover {
            opacity: 1;
        }
        .expiry-modal-body {
            padding: 0;
            background: #fafafa;
        }
        .expiry-table {
            margin: 0;
            width: 100%;
            border-collapse: separate;
            border-spacing: 0;
        }
        .expiry-table th {
            background: #f1f5f9;
            color: #475569;
            font-weight: 600;
            text-transform: uppercase;
            font-size: 0.75rem;
            letter-spacing: 0.5px;
            padding: 1rem 1.25rem;
            border-bottom: 2px solid #e2e8f0;
        }
        .expiry-table td {
            padding: 1rem 1.25rem;
            vertical-align: middle;
            border-bottom: 1px solid #e2e8f0;
            background: white;
            transition: background 0.2s;
        }
        .expiry-table tr:last-child td {
            border-bottom: none;
        }
        .expiry-table tr:hover td {
            background: #f8fafc;
        }
        .expiry-status-badge {
            padding: 0.4rem 0.8rem;
            border-radius: 50rem;
            font-weight: 700;
            font-size: 0.75rem;
            display: inline-flex;
            align-items: center;
            gap: 0.3rem;
        }
        .status-expired {
            background: #fee2e2;
            color: #b91c1c;
            border: 1px solid #fecaca;
        }
        .status-critical {
            background: #ffedd5;
            color: #c2410c;
            border: 1px solid #fed7aa;
        }
        .status-warning {
            background: #fef3c7;
            color: #b45309;
            border: 1px solid #fde68a;
        }
        .expiry-action-btn {
            background: white;
            color: #4f46e5;
            border: 1px solid #e0e7ff;
            padding: 0.4rem 0.8rem;
            border-radius: 6px;
            font-size: 0.8rem;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.2s;
            display: inline-block;
        }
        .expiry-action-btn:hover {
            background: #4f46e5;
            color: white;
            box-shadow: 0 4px 6px -1px rgba(79, 70, 229, 0.2);
        }
        .expiry-modal-footer {
            background: white;
            border-top: 1px solid #e2e8f0;
            padding: 1rem 1.5rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .view-all-link {
            color: #64748b;
            font-weight: 600;
            font-size: 0.85rem;
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 0.4rem;
            transition: color 0.2s;
        }
        .view-all-link:hover {
            color: #3b82f6;
        }
    </style>
    <link rel="stylesheet" href="/static/css/dashboard.css">
    <style>
        /* Dynamic theme overrides from Company Setup */
        :root {
            --primary-color: #1a1a2e;
            --secondary-color: #16213e;
        }
    </style>
    <style>
        /* ==================== SCROLLABLE SIDEBAR FIXES ==================== */
        .wrapper {
            display: flex;
            width: 100%;
            align-items: stretch;
            min-height: 100vh;
            overflow-x: hidden;
        }

        .sidebar {
            min-width: 250px;
            max-width: 250px;
            position: fixed;
            top: 0;
            left: 0;
            height: 100vh;
            z-index: 999;
            transition: all 0.3s;
            overflow: hidden;
            display: flex;
            flex-direction: column;
        }

        /* Sidebar scrollable content area - hidden until JS positions it */
        .sidebar .components {
            flex: 1;
            overflow-y: auto;
            overflow-x: hidden;
            padding-bottom: 1rem;
            visibility: hidden;
        }

        .sidebar .components.sidebar-ready {
            visibility: visible;
        }

        /* Custom scrollbar for sidebar */
        .sidebar .components::-webkit-scrollbar {
            width: 6px;
        }

        .sidebar .components::-webkit-scrollbar-track {
            background: rgba(255, 255, 255, 0.1);
        }

        .sidebar .components::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.3);
            border-radius: 3px;
        }

        .sidebar .components::-webkit-scrollbar-thumb:hover {
            background: rgba(255, 255, 255, 0.5);
        }

        /* Sidebar header - fixed at top */
        .sidebar-header {
            padding: 1.5rem;
            flex-shrink: 0;
        }

        /* Sidebar footer - fixed at bottom */
        .sidebar-footer {
            width: 100%;
            background: rgba(0, 0, 0, 0.1);
            flex-shrink: 0;
            border-top: 1px solid rgba(255, 255, 255, 0.1);
        }

        /* Content area adjustment */
        #content {
            width: calc(100% - 250px);
            min-height: 100vh;
            transition: all 0.3s;
            margin-left: 250px;
            overflow-x: hidden;
        }

        /* Sidebar collapsed state */
        .sidebar.active {
            margin-left: -250px;
        }

        #content.active {
            margin-left: 0;
            width: 100%;
        }

        /* Mobile responsive */
        @media (max-width: 768px) {
            .sidebar {
                margin-left: -250px;
            }

            .sidebar.active {
                margin-left: 0;
            }

            #content {
                margin-left: 0;
                width: 100%;
            }

            #content.active {
                margin-left: 0;
            }

            /* Mobile overlay when sidebar is open */
            .sidebar.active~#content::before {
                content: '';
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background: rgba(0, 0, 0, 0.5);
                z-index: 998;
            }
        }

        /* ==================== PERMISSION DENIED MODAL STYLING ==================== */
        #permissionDeniedModal .modal-content {
            border-radius: 15px;
            overflow: hidden;
        }

        #permissionDeniedModal .modal-header {
            background: linear-gradient(135deg, #dc3545 0%, #c82333 100%);
            padding: 1.5rem;
        }

        #permissionDeniedModal .modal-body {
            padding: 2rem;
        }

        #permissionDeniedModal .modal-body i.fa-lock {
            opacity: 0.8;
            animation: shake 0.5s ease-in-out;
        }

        @keyframes shake {

            0%,
            100% {
                transform: translateX(0);
            }

            25% {
                transform: translateX(-10px);
            }

            75% {
                transform: translateX(10px);
            }
        }

        #permissionDeniedModal .btn-primary {
            background: linear-gradient(135deg, #5e72e4 0%, #825ee4 100%);
            border: none;
            padding: 0.6rem 2rem;
            border-radius: 8px;
            transition: all 0.3s ease;
        }

        #permissionDeniedModal .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(94, 114, 228, 0.4);
        }

        /* ==================== ADDITIONAL RESPONSIVE FIXES ==================== */
        .container-fluid {
            padding-right: 15px;
            padding-left: 15px;
        }

        .table-responsive {
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
        }

        @media (max-width: 576px) {
            .card {
                margin-bottom: 1rem;
            }
        }

        /* ==================== MODERN SUBMENU STYLING ==================== */
        .sidebar ul.collapse {
            background: rgba(0, 0, 0, 0.1);
            border-left: 2px solid rgba(255, 193, 7, 0.3);
            margin-left: 10px;
        }

        .sidebar ul.collapse li a {
            padding-left: 3.5rem !important;
            font-size: 0.88rem;
            position: relative;
            border-left: 2px solid transparent;
            transition: all 0.3s ease;
        }

        .sidebar ul.collapse li a::before {
            content: '▸';
            position: absolute;
            left: 2.2rem;
            color: rgba(255, 255, 255, 0.5);
            font-size: 0.9rem;
            transition: all 0.3s ease;
        }

        .sidebar ul.collapse li a:hover {
            background: rgba(255, 193, 7, 0.1);
            border-left-color: #ffc107;
        }

        .sidebar ul.collapse li a:hover::before {
            color: #ffc107;
            left: 2.4rem;
        }

        .sidebar ul.collapse li.active a {
            background: rgba(255, 193, 7, 0.15);
            border-left-color: #ffc107;
        }

        .sidebar ul.collapse li.active a::before {
            content: '▸';
            color: #ffc107;
        }

        /* ==================== NCM BADGE STYLING ==================== */
        .ncm-badge {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 2px 8px;
            border-radius: 10px;
            font-size: 0.7rem;
            font-weight: 700;
            margin-left: 5px;
            animation: pulse 2s ease-in-out infinite;
        }

        @keyframes pulse {

            0%,
            100% {
                opacity: 1;
            }

            50% {
                opacity: 0.8;
            }
        }

        /* ==================== LOGISTICS MENU HIGHLIGHT ==================== */
        .sidebar li.logistics-menu>a {
            background: linear-gradient(135deg, rgba(102, 126, 234, 0.1) 0%, rgba(118, 75, 162, 0.1) 100%);
            border-left: 3px solid #667eea;
        }

        .sidebar li.logistics-menu:hover>a {
            background: linear-gradient(135deg, rgba(102, 126, 234, 0.2) 0%, rgba(118, 75, 162, 0.2) 100%);
            border-left-color: #764ba2;
        }

        /* ==================== STAFF PERFORMANCE MENU HIGHLIGHT ==================== */
        .sidebar li.staff-performance-menu>a {
            background: linear-gradient(135deg, rgba(34, 197, 94, 0.1) 0%, rgba(16, 185, 129, 0.1) 100%);
            border-left: 3px solid #22c55e;
            position: relative;
        }

        /* ==================== PURCHASE MANAGEMENT MENU HIGHLIGHT ==================== */
        .sidebar li.purchase-menu>a {
            background: linear-gradient(135deg, rgba(234, 88, 12, 0.1) 0%, rgba(220, 38, 38, 0.1) 100%);
            border-left: 3px solid #ea580c;
        }

        .sidebar li.purchase-menu:hover>a {
            background: linear-gradient(135deg, rgba(234, 88, 12, 0.2) 0%, rgba(220, 38, 38, 0.2) 100%);
            border-left-color: #dc2626;
        }

        .purchase-badge {
            background: linear-gradient(135deg, #ea580c 0%, #dc2626 100%);
            color: white;
            padding: 2px 8px;
            border-radius: 10px;
            font-size: 0.65rem;
            font-weight: 700;
            margin-left: 5px;
            display: inline-block;
        }

        .sidebar li.staff-performance-menu:hover>a {
            background: linear-gradient(135deg, rgba(34, 197, 94, 0.2) 0%, rgba(16, 185, 129, 0.2) 100%);
            border-left-color: #10b981;
        }

        .sidebar li.staff-performance-menu>a i {
            color: #22c55e;
            font-size: 1.1rem;
            transition: all 0.3s ease;
        }

        .sidebar li.staff-performance-menu:hover>a i {
            color: #10b981;
            transform: scale(1.1);
        }

        .performance-badge {
            background: linear-gradient(135deg, #22c55e 0%, #10b981 100%);
            color: white;
            padding: 2px 8px;
            border-radius: 10px;
            font-size: 0.65rem;
            font-weight: 700;
            margin-left: 8px;
            animation: pulse 2s ease-in-out infinite;
            display: inline-block;
        }

        /* ==================== LOW STOCK NOTIFICATION ==================== */
        .low-stock-notification {
            background: linear-gradient(135deg, #fffbeb 0%, #fef3c7 100%);
            border: 1px solid #fcd34d;
            border-left: 4px solid #f59e0b;
            border-radius: 12px;
            padding: 1rem 1.25rem;
            margin-bottom: 1.25rem;
            animation: lsnSlideDown 0.4s ease;
        }

        .lsn-content {
            display: flex;
            align-items: center;
            gap: 1rem;
            flex-wrap: wrap;
        }

        .lsn-icon {
            width: 42px;
