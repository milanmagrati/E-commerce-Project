            background: rgba(245, 158, 11, 0.15);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #b45309;
            font-size: 1.15rem;
            flex-shrink: 0;
        }

        .lsn-body {
